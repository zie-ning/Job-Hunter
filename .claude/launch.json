{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "C:\\Job Hunting\\backend\\venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-c",
        "import os; os.chdir('backend'); import uvicorn; uvicorn.run('app.main:app', host='127.0.0.1', port=8000)"
      ],
      "port": 8000
    }
  ]
}
